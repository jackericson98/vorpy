include LICENSE
include README.md
include pyproject.toml
include requirements.txt
include CMakeLists.txt


recursive-include vorpy *.cpp
recursive-include vorpy *.hpp
recursive-include vorpy *.txt
recursive-include vorpy *.md
recursive-include vorpy *.json
recursive-include vorpy *.pdb
recursive-include vorpy *.png
recursive-include vorpy *.ico

recursive-exclude _skbuild *
recursive-exclude build *
recursive-exclude dist *
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.so
recursive-exclude * .DS_Store
recursive-exclude * .git
recursive-exclude * .gitignore
recursive-exclude * .idea
recursive-exclude * .vscode

# Exclude verification foam datasets
recursive-exclude vorpy/data/VerificationFoams *
recursive-exclude vorpy/tests *

# Exclude agent state and generated diagnostics from source distributions.
prune .agent-reports
prune .agents
prune .pytest_cache
prune .hypothesis
prune .pytest-tmp-prism-release
recursive-exclude * *.log
recursive-exclude * *_verts.txt
