include LICENSE
include README.md
include pyproject.toml
include requirements.txt
include CMakeLists.txt


recursive-include vorpy *.cpp
recursive-include vorpy *.hpp
recursive-include vorpy/src/GUI/Images *.png *.ico
recursive-include vorpy/workbench/assets *.png
# Keep the redistributable example explicit.  Research structures and
# trajectory collections must not enter an sdist through stale egg-info.
recursive-exclude vorpy/data *.pdb
recursive-exclude vorpy/data 2KAI_Frames *
include vorpy/data/HO_cube.pdb

recursive-exclude _skbuild *
recursive-exclude build *
recursive-exclude dist *
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.so
recursive-exclude * .DS_Store
recursive-exclude * .git
recursive-exclude * .gitignore
recursive-exclude * .idea
recursive-exclude * .vscode

# Research structures, trajectory frames, and generated verification datasets
# are intentionally not part of the redistributable source/package payload.
recursive-exclude vorpy/tests *

# Exclude agent state and generated diagnostics from source distributions.
prune .agent-reports
prune .agents
prune .pytest_cache
prune .hypothesis
prune .pytest-tmp-prism-release
recursive-exclude * *.log
recursive-exclude * *_verts.txt
